    "audit:lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.3",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
{
  "scripts": {
    "lint": "pnpm --filter @ben-digital-club/ui lint",
    "typecheck": "pnpm --filter @ben-digital-club/ui type-check && pnpm --filter @ben-digital-club/www typecheck",
    "build": "pnpm --filter @ben-digital-club/ui build && pnpm --filter @ben-digital-club/www build",
    "test:unit": "vitest run test/unit",
    "test:component": "vitest run packages/ui/__tests__",
    "test:e2e": "playwright test",
    "audit:a11y": "playwright test e2e/accessibility.spec.ts",
    "audit:lighthouse": "lhci autorun"
  }
import react from '@vitejs/plugin-react';
import { defineConfig } from 'vitest/config';

export default defineConfig({
  plugins: [react()],
  test: {
    globals: true,
    environment: 'jsdom',
    setupFiles: ['./test/setup.ts'],
    include: [
      'test/unit/**/*.test.{ts,tsx}',
      'packages/ui/__tests__/**/*.test.{ts,tsx}',
    ],
    coverage: {
      provider: 'v8',
      reporter: ['text', 'lcov', 'html'],
      exclude: ['**/*.d.ts', '**/dist/**', '**/*.config.*'],
    },
  },
});import '@testing-library/jest-dom/vitest';
import { cleanup } from '@testing-library/react';
import { afterEach } from 'vitest';

afterEach(() => {
  cleanup();
});import { render, screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { describe, expect, it, vi } from 'vitest';

function ExampleButton({
  onClick,
}: {
  onClick: () => void;
}) {
  return <button onClick={onClick}>Continue</button>;
}

describe('ExampleButton', () => {
  it('renders an accessible button and handles activation', async () => {
    const user = userEvent.setup();
    const onClick = vi.fn();

    render(<ExampleButton onClick={onClick} />);

    const button = screen.getByRole('button', { name: 'Continue' });
    await user.click(button);

    expect(onClick).toHaveBeenCalledOnce();
  });
});}
