      "content": "name: CI\n\non:\n  pull_request:\n    branches: [main, develop]\n  push:\n    branches: [main, develop]\n  workflow_call:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: ci-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  checks:\n    name: Lint, typecheck, unit and component tests\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: pnpm/action-setup@v4\n        with:\n          version: 8.15.9\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 20\n\n      # Use --no-frozen-lockfile while this repository has no committed lockfile.\n      # Once pnpm-lock.yaml is committed, switch this to --frozen-lockfile.\n      - run: pnpm install --no-frozen-lockfile\n      - run: pnpm run lint\n      - run: pnpm run typecheck\n      - run: pnpm run test:unit\n      - run: pnpm run test:component\n\n  e2e:\n    name: E2E and accessibility tests\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: pnpm/action-setup@v4\n        with:\n          version: 8.15.9\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 20\n\n      - run: pnpm install --no-frozen-lockfile\n      - run: pnpm exec playwright install --with-deps chromium\n      - run: pnpm run test:e2e\n\n      - name: Upload Playwright report\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: playwright-report\n          path: playwright-report/\n          if-no-files-found: ignore\n          retention-days: 7\n\n  lighthouse:\n    name: Lighthouse audit\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: pnpm/action-setup@v4\n        with:\n          version: 8.15.9\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 20\n\n      - run: pnpm install --no-frozen-lockfile\n      - run: pnpm run build\n\n      - name: Start production server\n        run: |\n          pnpm --filter @ben-digital-club/www start -- --hostname 127.0.0.1 > /tmp/www.log 2>&1 &\n          for i in {1..60}; do\n            if curl --silent --fail http://127.0.0.1:3000/ >/dev/null; then\n              exit 0\n            fi\n            sleep 2\n          done\n          cat /tmp/www.log\n          exit 1\n\n      - run: pnpm run audit:lighthouse\n\n      - name: Upload Lighthouse report\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: lighthouse-report\n          path: lighthouse-reports/\n          if-no-files-found: ignore\n          retention-days: 7\n",
      "path": ".github/workflows/ci.yml"
