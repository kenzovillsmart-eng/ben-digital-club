      "content": "name: Deploy staging\n\non:\n  push:\n    branches: [develop]\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  packages: write\n\nconcurrency:\n  group: deploy-staging\n  cancel-in-progress: false\n\njobs:\n  ci:\n    uses: ./.github/workflows/ci.yml\n\n  deploy:\n    name: Build and deploy staging\n    needs: ci\n    runs-on: ubuntu-latest\n    environment: staging\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Build and push image to GHCR\n        id: image\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          GH_USER: ${{ github.actor }}\n          REPOSITORY: ${{ github.repository }}\n          SHA: ${{ github.sha }}\n        run: |\n          image=\"ghcr.io/$(printf '%s' \"$REPOSITORY\" | tr '[:upper:]' '[:lower:]'):$SHA\"\n          echo \"$GH_TOKEN\" | docker login ghcr.io -u \"$GH_USER\" --password-stdin\n          docker build --tag \"$image\" .\n          docker push \"$image\"\n          echo \"image=$image\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Configure SSH\n        env:\n          SSH_PRIVATE_KEY: ${{ secrets.DEPLOY_SSH_KEY }}\n          SSH_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}\n        run: |\n          install -m 700 -d ~/.ssh\n          printf '%s\\n' \"$SSH_PRIVATE_KEY\" > ~/.ssh/deploy_key\n          chmod 600 ~/.ssh/deploy_key\n          printf '%s\\n' \"$SSH_KNOWN_HOSTS\" > ~/.ssh/known_hosts\n          chmod 600 ~/.ssh/known_hosts\n\n      - name: Deploy staging image\n        env:\n          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}\n          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}\n          DEPLOY_PATH: ${{ vars.DEPLOY_PATH }}\n          IMAGE: ${{ steps.image.outputs.image }}\n        run: |\n          if [[ ! \"$DEPLOY_PATH\" =~ ^/[A-Za-z0-9._/-]+$ || \"$DEPLOY_PATH\" == *..* ]]; then\n            echo \"DEPLOY_PATH must be an absolute path without '..' segments\" >&2\n            exit 1\n          fi\n          printf -v remote_command 'cd %q && IMAGE=%q docker compose pull && IMAGE=%q docker compose up -d' \\\n            \"$DEPLOY_PATH\" \"$IMAGE\" \"$IMAGE\"\n          ssh -i ~/.ssh/deploy_key -o BatchMode=yes \"$DEPLOY_USER@$DEPLOY_HOST\" \"$remote_command\"\n",
      "path": ".github/workflows/deploy-staging.yml"
